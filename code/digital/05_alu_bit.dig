<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes>
    <entry>
      <string>Description</string>
      <string>第5章 一位 ALU 切片：XOr 算求和，And 算按位与，Mux 按 op 选一个输出。
op=0 时 result=a^b，op=1 时 result=a&amp;b。
把 32 个这样的切片串起来，加上进位链，就是完整 ALU 的加法部分。
对照教材第5章 5.4 节与 code/verilog/05_arith/alu.v。</string>
    </entry>
    <entry>
      <string>Width</string>
      <int>4</int>
    </entry>
  </attributes>
  <visualElements>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Description</string><string>操作数 a。</string></entry>
        <entry><string>Label</string><string>a</string></entry>
      </elementAttributes>
      <pos x="100" y="120"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Description</string><string>操作数 b。</string></entry>
        <entry><string>Label</string><string>b</string></entry>
      </elementAttributes>
      <pos x="100" y="300"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Description</string><string>操作选择，0 选求和，1 选按位与。</string></entry>
        <entry><string>Label</string><string>op</string></entry>
      </elementAttributes>
      <pos x="100" y="420"/>
    </visualElement>
    <visualElement>
      <elementName>XOr</elementName>
      <elementAttributes/>
      <pos x="300" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="300" y="260"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes>
        <entry><string>Bits</string><int>1</int></entry>
      </elementAttributes>
      <pos x="480" y="160"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Description</string><string>这一位的运算结果。</string></entry>
        <entry><string>Label</string><string>result</string></entry>
      </elementAttributes>
      <pos x="660" y="180"/>
    </visualElement>
  </visualElements>
  <wires>
    <wire><p1 x="100" y="120"/><p2 x="280" y="120"/></wire>
    <wire><p1 x="280" y="120"/><p2 x="280" y="140"/></wire>
    <wire><p1 x="280" y="140"/><p2 x="300" y="140"/></wire>
    <wire><p1 x="100" y="120"/><p2 x="200" y="120"/></wire>
    <wire><p1 x="200" y="120"/><p2 x="200" y="260"/></wire>
    <wire><p1 x="200" y="260"/><p2 x="300" y="260"/></wire>
    <wire><p1 x="100" y="300"/><p2 x="60" y="300"/></wire>
    <wire><p1 x="60" y="300"/><p2 x="60" y="100"/></wire>
    <wire><p1 x="60" y="100"/><p2 x="290" y="100"/></wire>
    <wire><p1 x="290" y="100"/><p2 x="290" y="160"/></wire>
    <wire><p1 x="290" y="160"/><p2 x="300" y="160"/></wire>
    <wire><p1 x="100" y="300"/><p2 x="280" y="300"/></wire>
    <wire><p1 x="280" y="300"/><p2 x="280" y="280"/></wire>
    <wire><p1 x="280" y="280"/><p2 x="300" y="280"/></wire>
    <wire><p1 x="330" y="150"/><p2 x="420" y="150"/></wire>
    <wire><p1 x="420" y="150"/><p2 x="420" y="160"/></wire>
    <wire><p1 x="420" y="160"/><p2 x="460" y="160"/></wire>
    <wire><p1 x="330" y="270"/><p2 x="450" y="270"/></wire>
    <wire><p1 x="450" y="270"/><p2 x="450" y="200"/></wire>
    <wire><p1 x="450" y="200"/><p2 x="480" y="200"/></wire>
    <wire><p1 x="100" y="420"/><p2 x="500" y="420"/></wire>
    <wire><p1 x="500" y="420"/><p2 x="500" y="280"/></wire>
    <wire><p1 x="520" y="180"/><p2 x="660" y="180"/></wire>
  </wires>
</circuit>
